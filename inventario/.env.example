# ====================================================================
# CONFIGURACIÓN DE ENTORNO - INVENTARIO SOLUCIONES LÓGICAS
# ====================================================================

# Entorno de la aplicación
FLASK_ENV=development

# Clave secreta para sesiones (CAMBIAR EN PRODUCCIÓN)
SECRET_KEY=tu-clave-secreta-muy-segura-de-32-caracteres-minimo

# ====================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ====================================================================

# Para RENDER.COM (Producción) - URL completa
DATABASE_URL=postgresql://usuario:password@host:puerto/database

# Para desarrollo local (alternativo)
DB_HOST=localhost
DB_NAME=inventario_sistema
DB_USER=postgres
DB_PASS=password
DB_PORT=5432

# ====================================================================
# CONFIGURACIÓN DE SERVIDOR
# ====================================================================

# Puerto para la aplicación (Render usa PORT automáticamente)
PORT=10000

# ====================================================================
# CONFIGURACIÓN DE AUTENTICACIÓN
# ====================================================================

# Credenciales de administrador (CAMBIAR EN PRODUCCIÓN)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=02120212$

# ====================================================================
# CONFIGURACIÓN DE CORS (Dominios permitidos)
# ====================================================================

# Dominios permitidos separados por comas
ALLOWED_ORIGINS=http://localhost:10000,https://tu-dominio.onrender.com

# ====================================================================
# CONFIGURACIÓN DE LOGS
# ====================================================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ====================================================================
# NOTAS IMPORTANTES:
# ====================================================================
# 1. Copia este archivo como .env y configura tus valores reales
# 2. NUNCA subas el archivo .env al repositorio
# 3. En producción, configura estas variables en tu plataforma de hosting
# 4. Cambia las credenciales por defecto antes de usar en producción